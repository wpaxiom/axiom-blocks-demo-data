<p class="has-text-align-center has-text-color" style="color:#7C3AED;font-size:13px;font-style:normal;font-weight:600;letter-spacing:0.14em;text-transform:uppercase">Pricing</p>
<!-- /wp:paragraph -->

<!-- wp:axiom-blocks/advanced-heading {"headingText":"Simple plans that scale with you","subEnabled":true,"subText":"Start free. Upgrade when your team does. No per-seat surprises.","headingSubGap":"16px","headingColor":"#17131F","subColor":"#5C5768","headingFontFamily":"'Space Grotesk', sans-serif","headingFontWeight":"600","headingFontSize":"clamp(28px,4vw,42px)","headingLineHeight":"1.08","headingLetterSpacing":"-0.02em","headingTextAlign":"center","subFontFamily":"'DM Sans', system-ui, sans-serif","subFontSize":"clamp(17px,2vw,19px)","subLineHeight":"1.55","subTextAlign":"center","marginTop":"14px"} -->
<div class="wp-block-axiom-blocks-advanced-heading ab-ah"><h2 class="ab-ah__heading">Simple plans that scale with you</h2><p class="ab-ah__sub">Start free. Upgrade when your team does. No per-seat surprises.</p></div>
<!-- /wp:axiom-blocks/advanced-heading -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:axiom-blocks/pricing-table {"gap":20,"nameColor":"#17131F","priceColor":"#17131F","descColor":"#5C5768","featureColor":"#5C5768","cardPaddingTop":"32px","cardPaddingRight":"32px","cardPaddingBottom":"32px","cardPaddingLeft":"32px","cardGap":"0px","ctaPaddingTop":"14px","ctaPaddingBottom":"14px","ctaRadiusTopLeft":"10px","ctaRadiusTopRight":"10px","ctaRadiusBottomRight":"10px","ctaRadiusBottomLeft":"10px","ctaBorderStyle":"solid","ctaBorderColor":"#E3E1EC","currencyColor":"#17131F","priceGap":"0px","headingGap":"18px","featIconGap":"10px","featureGap":"13px","featIconSize":"18px","badgeFontFamily":"'DM Sans', system-ui, sans-serif","badgeFontWeight":"600","badgeFontSize":"11.5px","badgeLetterSpacing":"0.08em","currencyFontFamily":"'Space Grotesk', sans-serif","currencyFontWeight":"600","currencyFontSize":"48px","currencyLetterSpacing":"-0.03em","badgeBg":"#7C3AED","badgeColor":"#FFFFFF","featIconColor":"#7C3AED","nameFontFamily":"'Space Grotesk', sans-serif","nameFontWeight":"600","nameFontSize":"19px","priceFontFamily":"'Space Grotesk', sans-serif","priceFontWeight":"600","priceFontSize":"48px","priceLetterSpacing":"-0.03em","periodColor":"#8B8797","periodFontFamily":"'DM Sans', system-ui, sans-serif","periodFontSize":"15px","descFontFamily":"'DM Sans', system-ui, sans-serif","descFontSize":"14px","featureFontFamily":"'DM Sans', system-ui, sans-serif","featureFontSize":"15px","ctaFontFamily":"'DM Sans', system-ui, sans-serif","ctaFontWeight":"600","ctaFontSize":"16px","cardBg":"#FFFFFF","cardBorderTopWidth":"1px","cardBorderRightWidth":"1px","cardBorderBottomWidth":"1px","cardBorderLeftWidth":"1px","cardBorderStyle":"solid","cardBorderColor":"#EBE9F2","cardRadiusTopLeft":"16px","cardRadiusTopRight":"16px","cardRadiusBottomRight":"16px","cardRadiusBottomLeft":"16px","cardShadowFeatured":"0 1px 2px #17131F0A, 0 18px 40px -20px #17131F29","marginTop":"56px","align":"wide"} -->
<!-- wp:axiom-blocks/pricing-plan {"name":"Starter","period":"/ month","description":"For side projects and small teams finding their rhythm.","features":[{"id":"s1","text":"Up to 3 projects","included":true},{"id":"s2","text":"50 deploys / month","included":true},{"id":"s3","text":"Community support","included":true}],"ctaLabel":"Start free","ctaUrl":"#"} -->
<article class="wp-block-axiom-blocks-pricing-plan ab-pt-plan"><h3 class="ab-pt-plan__name">Starter</h3><div class="ab-pt-plan__price"><span class="ab-pt-plan__currency">$</span><span class="ab-pt-plan__amount">0</span><span class="ab-pt-plan__period">/ month</span></div><p class="ab-pt-plan__desc">For side projects and small teams finding their rhythm.</p><ul class="ab-pt-plan__features"><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Up to 3 projects</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">50 deploys / month</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Community support</span></li></ul><div class="ab-pt-plan__cta-area"><a class="ab-pt-plan__cta" href="#">Start free</a></div></article>
<!-- /wp:axiom-blocks/pricing-plan -->

<!-- wp:axiom-blocks/pricing-plan {"name":"Team","badge":"Most popular","price":"29","period":"/ user / mo","description":"For growing teams who ship every day and can't afford surprises.","isHighlight":true,"features":[{"id":"t1","text":"Unlimited projects \u0026amp; deploys","included":true},{"id":"t2","text":"Preview environments","included":true},{"id":"t3","text":"Release insights dashboard","included":true},{"id":"t4","text":"Priority support","included":true}],"ctaLabel":"Start 14-day trial","ctaUrl":"#"} -->
<article class="wp-block-axiom-blocks-pricing-plan ab-pt-plan is-highlight"><div class="ab-pt-plan__badge">Most popular</div><h3 class="ab-pt-plan__name">Team</h3><div class="ab-pt-plan__price"><span class="ab-pt-plan__currency">$</span><span class="ab-pt-plan__amount">29</span><span class="ab-pt-plan__period">/ user / mo</span></div><p class="ab-pt-plan__desc">For growing teams who ship every day and can't afford surprises.</p><ul class="ab-pt-plan__features"><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Unlimited projects &amp; deploys</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Preview environments</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Release insights dashboard</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Priority support</span></li></ul><div class="ab-pt-plan__cta-area"><a class="ab-pt-plan__cta" href="#">Start 14-day trial</a></div></article>
<!-- /wp:axiom-blocks/pricing-plan -->

<!-- wp:axiom-blocks/pricing-plan {"name":"Enterprise","price":"Custom","showCurrency":false,"showPeriod":false,"description":"For organizations with compliance and scale requirements.","features":[{"id":"e1","text":"SSO \u0026amp; SCIM provisioning","included":true},{"id":"e2","text":"Audit logs \u0026amp; SOC 2","included":true},{"id":"e3","text":"Dedicated success manager","included":true},{"id":"e4","text":"99.99% uptime SLA","included":true}],"ctaLabel":"Talk to sales","ctaUrl":"#"} -->
<article class="wp-block-axiom-blocks-pricing-plan ab-pt-plan"><h3 class="ab-pt-plan__name">Enterprise</h3><div class="ab-pt-plan__price"><span class="ab-pt-plan__amount">Custom</span></div><p class="ab-pt-plan__desc">For organizations with compliance and scale requirements.</p><ul class="ab-pt-plan__features"><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">SSO &amp; SCIM provisioning</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Audit logs &amp; SOC 2</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">Dedicated success manager</span></li><li class="ab-pt-feat is-included"><span class="ab-pt-feat__text">99.99% uptime SLA</span></li></ul><div class="ab-pt-plan__cta-area"><a class="ab-pt-plan__cta" href="#">Talk to sales</a></div></article>
<!-- /wp:axiom-blocks/pricing-plan -->
<!-- /wp:axiom-blocks/pricing-table -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:axiom-blocks/advanced-section {"bgType":"color","bgColor":"#FBFBFD","minHeight":"auto","verticalAlign":"top","align":"full","paddingTop":"clamp(72px,10vw,132px)","paddingRight":"clamp(20px,5vw,40px)","paddingBottom":"clamp(72px,10vw,132px)","paddingLeft":"clamp(20px,5vw,40px)","layout":{"type":"default"},"anchor":"faq"} -->
<!-- wp:axiom-blocks/advanced-section {"bgType":"color","bgColor":"transparent","minHeight":"auto","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"0px","borderLeftWidth":"0px","layout":{"type":"default"}} -->
<!-- wp:paragraph {"className":"has-text-color","style":{"typography":{"fontSize":"13px","fontStyle":"normal","fontWeight":"600","letterSpacing":"0.14em","textTransform":"uppercase","textAlign":"center"},"color":{"text":"#7C3AED"}}} -->
<p class="has-text-align-center has-text-color" style="color:#7C3AED;font-size:13px;font-style:normal;font-weight:600;letter-spacing:0.14em;text-transform:uppercase">FAQ</p>
<!-- /wp:paragraph -->

<!-- wp:axiom-blocks/advanced-heading {"headingText":"Questions, answered","headingColor":"#17131F","headingFontFamily":"'Space Grotesk', sans-serif","headingFontWeight":"600","headingFontSize":"clamp(28px,4vw,42px)","headingLineHeight":"1.08","headingLetterSpacing":"-0.02em","headingTextAlign":"center","marginTop":"14px"} -->
<div class="wp-block-axiom-blocks-advanced-heading ab-ah"><h2 class="ab-ah__heading">Questions, answered</h2></div>
<!-- /wp:axiom-blocks/advanced-heading -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:axiom-blocks/advanced-section {"bgType":"color","bgColor":"transparent","minHeight":"auto","align":"wide","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"0px","borderLeftWidth":"0px","marginTop":"52px","layout":{"type":"default"}} -->
<!-- wp:axiom-blocks/accordion {"faqSchema":true,"iconColor":"#8B8797","iconColorActive":"#7C3AED","iconSize":"22px","itemBg":"transparent","itemBgHover":"transparent","bodyMaxWidth":"660px","headerBg":"transparent","headerColor":"#17131F","headerBgHover":"transparent","headerColorHover":"#17131F","activeHeaderBg":"transparent","activeHeaderColor":"#17131F","headerPaddingTop":"24px","headerPaddingRight":"4px","headerPaddingBottom":"24px","headerPaddingLeft":"4px","bodyBg":"transparent","bodyColor":"#5C5768","bodyPaddingTop":"0px","bodyPaddingRight":"4px","bodyPaddingBottom":"26px","bodyPaddingLeft":"4px","borderColor":"#EBE9F2","itemGap":"0px","borderStyle":"solid","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"1px","borderLeftWidth":"0px","radiusTopLeft":"0px","radiusTopRight":"0px","radiusBottomRight":"0px","radiusBottomLeft":"0px","containerBorderColor":"#EBE9F2","containerBorderStyle":"solid","containerBorderTopWidth":"1px","headerFontFamily":"'Space Grotesk', sans-serif","headerFontWeight":"500","headerFontSize":"19px","headerLetterSpacing":"-0.01em"} -->
<!-- wp:axiom-blocks/accordion-item {"title":"How long does it take to set up?"} -->
<details class="wp-block-axiom-blocks-accordion-item ab-accordion__item"><summary class="ab-accordion__header"><span class="ab-accordion__title">How long does it take to set up?</span></summary><div class="ab-accordion__body"><div class="ab-accordion__body-inner"><!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Most teams connect their repository and ship a first preview deploy within an afternoon. There's no infrastructure to provision — Sable runs your builds and environments for you.</p>
<!-- /wp:paragraph --></div></div></details>
<!-- /wp:axiom-blocks/accordion-item -->

<!-- wp:axiom-blocks/accordion-item {"title":"Which git providers do you support?"} -->
<details class="wp-block-axiom-blocks-accordion-item ab-accordion__item"><summary class="ab-accordion__header"><span class="ab-accordion__title">Which git providers do you support?</span></summary><div class="ab-accordion__body"><div class="ab-accordion__body-inner"><!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">GitHub, GitLab, and Bitbucket are supported out of the box, including self-hosted GitHub Enterprise. Deploys can target any major cloud or your own Kubernetes cluster.</p>
<!-- /wp:paragraph --></div></div></details>
<!-- /wp:axiom-blocks/accordion-item -->

<!-- wp:axiom-blocks/accordion-item {"title":"Can I roll back a bad release?"} -->
<details class="wp-block-axiom-blocks-accordion-item ab-accordion__item"><summary class="ab-accordion__header"><span class="ab-accordion__title">Can I roll back a bad release?</span></summary><div class="ab-accordion__body"><div class="ab-accordion__body-inner"><!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Yes — every release is atomic and immutable. Rolling back is a single click and takes effect in seconds, with zero downtime and no partial states.</p>
<!-- /wp:paragraph --></div></div></details>
<!-- /wp:axiom-blocks/accordion-item -->

<!-- wp:axiom-blocks/accordion-item {"title":"Is my data secure?"} -->
<details class="wp-block-axiom-blocks-accordion-item ab-accordion__item"><summary class="ab-accordion__header"><span class="ab-accordion__title">Is my data secure?</span></summary><div class="ab-accordion__body"><div class="ab-accordion__body-inner"><!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Secrets are encrypted at rest and in transit, scoped per environment, and never exposed in logs. Enterprise plans add SSO, audit logging, and SOC 2 Type II compliance.</p>
<!-- /wp:paragraph --></div></div></details>
<!-- /wp:axiom-blocks/accordion-item -->

<!-- wp:axiom-blocks/accordion-item {"title":"What happens when my trial ends?"} -->
<details class="wp-block-axiom-blocks-accordion-item ab-accordion__item"><summary class="ab-accordion__header"><span class="ab-accordion__title">What happens when my trial ends?</span></summary><div class="ab-accordion__body"><div class="ab-accordion__body-inner"><!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Nothing breaks. Your projects stay live and you drop to the free Starter plan automatically unless you choose to upgrade. No credit card is required to start.</p>
<!-- /wp:paragraph --></div></div></details>
<!-- /wp:axiom-blocks/accordion-item -->
<!-- /wp:axiom-blocks/accordion -->
<!-- /wp:axiom-blocks/advanced-section -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:axiom-blocks/advanced-section {"bgType":"gradient","bgGradType":"radial","bgGradStops":[{"color":"#221A34","position":0},{"color":"#171225","position":70}],"minHeight":"auto","verticalAlign":"top","align":"full","paddingTop":"clamp(72px,10vw,132px)","paddingRight":"clamp(20px,5vw,40px)","paddingBottom":"clamp(72px,10vw,132px)","paddingLeft":"clamp(20px,5vw,40px)","layout":{"type":"constrained"}} -->
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Your next release could be your calmest","subEnabled":true,"subText":"Join 1,200+ teams shipping with confidence. Free to start, no card required.","headingSubGap":"18px","headingColor":"#FFFFFF","subColor":"#C7C0DA","headingFontFamily":"'Space Grotesk', sans-serif","headingFontWeight":"600","headingFontSize":"clamp(30px,4.4vw,48px)","headingLineHeight":"1.08","headingLetterSpacing":"-0.025em","headingTextAlign":"center","subFontFamily":"'DM Sans', system-ui, sans-serif","subFontSize":"clamp(18px,2.2vw,21px)","subLineHeight":"1.55","subTextAlign":"center","marginBottom":"30px"} -->
<div class="wp-block-axiom-blocks-advanced-heading ab-ah"><h2 class="ab-ah__heading">Your next release could be your calmest</h2><p class="ab-ah__sub">Join 1,200+ teams shipping with confidence. Free to start, no card required.</p></div>
<!-- /wp:axiom-blocks/advanced-heading -->

<!-- wp:axiom-blocks/button-group {"justify":"center"} -->
<!-- wp:axiom-blocks/advanced-button {"text":"Start free","url":"#","icon":"arrow-right","iconSize":"17px","iconGap":"8px","sizePreset":"lg","textColor":"#171225","bgColor":"#FFFFFF","borderRadius":"10px","hoverTextColor":"#171225","hoverBgColor":"#F1EEFB","fontFamily":"'DM Sans', system-ui, sans-serif","fontWeight":"600","fontSize":"16px","lineHeight":"1","buttonPaddingTop":"14px","buttonPaddingRight":"22px","buttonPaddingBottom":"14px","buttonPaddingLeft":"22px"} -->
<div class="wp-block-axiom-blocks-advanced-button ab-adv-btn-wrap"><a class="ab-adv-btn" href="#"><span class="ab-adv-btn__content"><span class="ab-adv-btn__text">Start free</span></span></a></div>
<!-- /wp:axiom-blocks/advanced-button -->

<!-- wp:axiom-blocks/advanced-button {"text":"Book a demo","url":"#","stylePreset":"outline","sizePreset":"lg","textColor":"#FFFFFF","bgColor":"transparent","borderColor":"#FFFFFF47","borderWidth":"1px","borderRadius":"10px","hoverTextColor":"#FFFFFF","hoverBgColor":"transparent","hoverBorderColor":"#FFFFFF","fontFamily":"'DM Sans', system-ui, sans-serif","fontWeight":"600","fontSize":"16px","lineHeight":"1","buttonPaddingTop":"14px","buttonPaddingRight":"22px","buttonPaddingBottom":"14px","buttonPaddingLeft":"22px"} -->
<div class="wp-block-axiom-blocks-advanced-button ab-adv-btn-wrap"><a class="ab-adv-btn" href="#"><span class="ab-adv-btn__content"><span class="ab-adv-btn__text">Book a demo</span></span></a></div>
<!-- /wp:axiom-blocks/advanced-button -->
<!-- /wp:axiom-blocks/button-group -->

<!-- wp:paragraph {"className":"has-text-color","style":{"typography":{"fontSize":"13.5px","textAlign":"center"},"color":{"text":"#8B84A0"},"spacing":{"margin":{"top":"18px"}}}} -->
<p class="has-text-align-center has-text-color" style="color:#8B84A0;margin-top:18px;font-size:13.5px">14-day Team trial · cancel anytime</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/advanced-section -->]]></content:encoded>
