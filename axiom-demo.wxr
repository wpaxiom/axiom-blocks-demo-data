<!-- wp:axiom-blocks/testimonials {"gap":"20px","cardBg":"#FFFFFF","cardBorderColor":"#EBE9F2","cardBorderWidth":"1px","cardRadius":"16px","cardShadow":false,"cardPaddingTop":"28px","cardPaddingRight":"28px","cardPaddingBottom":"28px","cardPaddingLeft":"28px","avatarPosition":"left","avatarSize":"42px","ratingColor":"#7C3AED","showQuoteIcon":false,"monoBg":"#F1EBFE","monoColor":"#4C1D95","nameColor":"#17131F","roleColor":"#8B8797","companyColor":"#8B8797","quoteColor":"#17131F","nameFontFamily":"'DM Sans', system-ui, sans-serif","nameFontWeight":"600","nameFontSize":"14.5px","roleFontFamily":"'DM Sans', system-ui, sans-serif","roleFontSize":"13px","companyFontFamily":"'DM Sans', system-ui, sans-serif","companyFontSize":"13px","monoFontFamily":"'Space Grotesk', sans-serif","monoFontWeight":"600","monoFontSize":"15px","quoteFontFamily":"'DM Sans', system-ui, sans-serif","quoteFontSize":"16px","quoteLineHeight":"1.62","marginTop":"52px","align":"wide"} -->
<!-- wp:axiom-blocks/testimonial {"quote":"We cut our release cycle from a nervous Friday ritual to something we do a dozen times a day without thinking. Rollbacks used to be a war room — now they're a button.","name":"Jordan Reyes","role":"Staff Engineer","company":"Northwind","useInitials":true} -->
<div class="wp-block-axiom-blocks-testimonial ab-testimonial"><blockquote class="ab-testimonial__quote"><p>We cut our release cycle from a nervous Friday ritual to something we do a dozen times a day without thinking. Rollbacks used to be a war room — now they're a button.</p><cite><p class="ab-testimonial__name">Jordan Reyes</p><p class="ab-testimonial__role">Staff Engineer</p><p class="ab-testimonial__company">Northwind</p></cite></blockquote></div>
<!-- /wp:axiom-blocks/testimonial -->

<!-- wp:axiom-blocks/testimonial {"quote":"Preview environments changed how our designers and engineers talk. Everyone reviews the actual thing. We catch UX issues days earlier.","name":"Mira Patel","role":"Eng Manager","company":"Quanta","useInitials":true} -->
<div class="wp-block-axiom-blocks-testimonial ab-testimonial"><blockquote class="ab-testimonial__quote"><p>Preview environments changed how our designers and engineers talk. Everyone reviews the actual thing. We catch UX issues days earlier.</p><cite><p class="ab-testimonial__name">Mira Patel</p><p class="ab-testimonial__role">Eng Manager</p><p class="ab-testimonial__company">Quanta</p></cite></blockquote></div>
<!-- /wp:axiom-blocks/testimonial -->

<!-- wp:axiom-blocks/testimonial {"quote":"Setup took an afternoon and immediately paid for itself. The insights dashboard is the first thing I open every standup.","name":"Devin Ko","role":"CTO","company":"Apex Labs","useInitials":true} -->
<div class="wp-block-axiom-blocks-testimonial ab-testimonial"><blockquote class="ab-testimonial__quote"><p>Setup took an afternoon and immediately paid for itself. The insights dashboard is the first thing I open every standup.</p><cite><p class="ab-testimonial__name">Devin Ko</p><p class="ab-testimonial__role">CTO</p><p class="ab-testimonial__company">Apex Labs</p></cite></blockquote></div>
<!-- /wp:axiom-blocks/testimonial -->
<!-- /wp:axiom-blocks/testimonials -->
<!-- /wp:axiom-blocks/advanced-section -->

