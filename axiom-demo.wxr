<p class="has-text-align-center has-text-color" style="color:#7C3AED;font-size:13px;font-style:normal;font-weight:600;letter-spacing:0.14em;line-height:1;text-transform:uppercase">Blog</p>
<!-- /wp:paragraph -->

<!-- wp:axiom-blocks/advanced-heading {"headingText":"Notes from the \u003cmark class=\u0022ab-ah-highlight\u0022\u003erelease pipeline\u003c/mark\u003e","tagName":"h1","subEnabled":true,"subText":"Short, practical writing on deploys, previews and the parts of shipping software nobody puts on a slide.","headingSubGap":"20px","highlightColor":"#7C3AED","highlightBg":"transparent","headingColor":"#17131F","subColor":"#5C5768","headingFontFamily":"'Space Grotesk', sans-serif","headingFontWeight":"600","headingFontSize":"clamp(36px,5.4vw,56px)","headingLineHeight":"1.08","headingLetterSpacing":"-0.032em","headingTextAlign":"center","subFontFamily":"'DM Sans', system-ui, sans-serif","subFontSize":"clamp(17px,2vw,19px)","subLineHeight":"1.55","subTextAlign":"center","marginTop":"18px","marginBottom":"0px"} -->
