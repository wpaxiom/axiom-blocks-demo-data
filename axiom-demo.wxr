		<link>https://wpaxiom.com/wp-global-styles-twentytwentyfive/</link>
		<pubDate>Tue, 14 Jul 2026 14:40:31 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://wpaxiom.com/wp-global-styles-twentytwentyfive/</guid>
		<description></description>
		<content:encoded><![CDATA[{"styles":{"color":{"background":"var(--wp--preset--color--base)","text":"var(--wp--preset--color--muted)"},"typography":{"fontFamily":"var(--wp--preset--font-family--dm-sans)","fontSize":"18px","lineHeight":"1.6"},"elements":{"heading":{"typography":{"fontFamily":"var(--wp--preset--font-family--space-grotesk)","fontWeight":"600","letterSpacing":"-0.02em"},"color":{"text":"var(--wp--preset--color--contrast)"}},"link":{"color":{"text":"var(--wp--preset--color--accent)"}},"button":{"color":{"background":"var(--wp--preset--color--accent)","text":"#FFFFFF"},"border":{"radius":"10px"}}},"css":"@font-face{font-family:'DM Sans';font-style:normal;font-weight:100 900;font-display:swap;src:url(https://fonts.gstatic.com/s/dmsans/v17/rP2Yp2ywxg089UriI5-g4vlH9VoD8Cmcqbu0-K4.woff2) format('woff2')}@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:300 700;font-display:swap;src:url(https://fonts.gstatic.com/s/spacegrotesk/v22/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2) format('woff2')}.axiom-fill{width:100%}.axiom-head{overflow:visible;-webkit-backdrop-filter:saturate(1.4) blur(14px);backdrop-filter:saturate(1.4) blur(14px)}.axiom-brand a{color:inherit;text-decoration:none}.axiom-foot-links .ab-icon-list__icon:empty{display:none}.axiom-foot-links .ab-icon-list__link{text-decoration:none}.axiom-social .wp-social-link{border:1px solid #EBE9F2;border-radius:10px}.axiom-social .wp-social-link:hover{border-color:#7C3AED}.wp-block-group.axiom-foot-grid{grid-template-columns:1fr}@media(min-width:901px){.wp-block-group.axiom-foot-grid{grid-template-columns:1.6fr 1fr 1fr 1fr}}.wp-block-post-title{display:none!important}.axiom-blocks-section.is-layout-flow>*,.axiom-blocks-section.is-layout-constrained>*{margin-block-start:0}.axiom-shot{margin:0!important}.axiom-shot img{display:block;width:100%;height:auto}html{scroll-behavior:smooth}::selection{background:#F1EBFE;color:#4C1D95}.ab-accordion{width:100%}.ab-accordion__body-inner.ab-accordion__body-inner{margin-inline:0}.ab-pt-plan__name{order:1}.ab-pt-plan__desc.ab-pt-plan__desc{order:2;margin-top:6px;min-height:40px;opacity:1}.ab-pt-plan__price.ab-pt-plan__price{order:3;margin:18px 0 0}.ab-pt-plan__currency.ab-pt-plan__currency{align-self:baseline;margin-top:0;opacity:1}.ab-pt-plan__period.ab-pt-plan__period{opacity:1}.ab-pt-plan__cta-area.ab-pt-plan__cta-area{order:4;margin-top:24px}.ab-pt-plan__features.ab-pt-plan__features{order:5;margin:26px 0 0;padding-top:26px;border-top:1px solid #EBE9F2}.ab-pt-plan__badge.ab-pt-plan__badge{left:32px;transform:none}.ab-pt-plan__cta.ab-pt-plan__cta{background:#FFFFFF;color:#17131F;border-color:#E3E1EC}.ab-pt-plan__cta.ab-pt-plan__cta:hover,.ab-pt-plan__cta.ab-pt-plan__cta:focus-visible{background:#FFFFFF;color:#7C3AED;border-color:#7C3AED;opacity:1}.ab-pt-plan.is-highlight .ab-pt-plan__cta.ab-pt-plan__cta{background:#7C3AED;color:#FFFFFF;border-color:transparent}.ab-pt-plan.is-highlight .ab-pt-plan__cta.ab-pt-plan__cta:hover,.ab-pt-plan.is-highlight .ab-pt-plan__cta.ab-pt-plan__cta:focus-visible{background:#6D28D9;color:#FFFFFF;border-color:transparent;opacity:1}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}.wp-site-blocks>header.wp-block-template-part,.wp-site-blocks>main,.wp-site-blocks>footer.wp-block-template-part{margin-block-start:0;margin-block-end:0}"},"settings":{"color":{"palette":{"custom":[{"slug":"base","color":"#FBFBFD","name":"Base"},{"slug":"contrast","color":"#17131F","name":"Ink"},{"slug":"surface","color":"#FFFFFF","name":"Surface"},{"slug":"tint","color":"#F5F3FB","name":"Tint"},{"slug":"muted","color":"#5C5768","name":"Muted"},{"slug":"border","color":"#EBE9F2","name":"Border"},{"slug":"accent","color":"#7C3AED","name":"Accent"},{"slug":"accent-tint","color":"#F1EBFE","name":"Accent tint"},{"slug":"ink-deep","color":"#171225","name":"Ink deep"}]}},"layout":{"contentSize":"1160px","wideSize":"1160px"},"spacing":{"spacingSizes":{"custom":[{"slug":"40","size":"20px","name":"S"},{"slug":"60","size":"clamp(40px,6vw,64px)","name":"M"},{"slug":"80","size":"clamp(72px,10vw,132px)","name":"XL section"}]}},"typography":{"fontFamilies":{"theme":[{"slug":"manrope","name":"Manrope","fontFamily":"Manrope, sans-serif"},{"slug":"fira-code","name":"Fira Code","fontFamily":"\"Fira Code\", monospace"}],"custom":[{"slug":"dm-sans","name":"DM Sans","fontFamily":"\"DM Sans\", sans-serif"},{"slug":"space-grotesk","name":"Space Grotesk","fontFamily":"\"Space Grotesk\", sans-serif"}]}}},"isGlobalStylesUserThemeJSON":true,"version":3}]]></content:encoded>
		<excerpt:encoded><![CDATA[]]></excerpt:encoded>
