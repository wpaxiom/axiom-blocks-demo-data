		<description></description>
		<content:encoded><![CDATA[<!-- wp:axiom-blocks/advanced-section {"align":"full","layout":{"type":"constrained","contentSize":"1160px"},"bgType":"color","bgColor":"#FFFFFF","minHeight":"auto","verticalAlign":"top","horizontalAlign":"center","borderStyle":"solid","borderColor":"#EBE9F2","borderTopWidth":"1px","borderRightWidth":"0px","borderBottomWidth":"0px","borderLeftWidth":"0px","paddingTop":"clamp(56px,7vw,80px)","paddingBottom":"40px","paddingRight":"clamp(20px,5vw,40px)","paddingLeft":"clamp(20px,5vw,40px)"} -->
<!-- wp:group {"className":"axiom-foot-grid axiom-fill","style":{"spacing":{"blockGap":"40px"}},"layout":{"type":"grid","columnCount":4}} -->
<div class="wp-block-group axiom-foot-grid axiom-fill">
<!-- wp:group {"style":{"spacing":{"blockGap":"0"}},"layout":{"type":"default"}} -->
<div class="wp-block-group">
<!-- wp:group {"style":{"spacing":{"blockGap":"10px","margin":{"bottom":"14px"}}},"layout":{"type":"flex","flexWrap":"nowrap"}} -->
<div class="wp-block-group" style="margin-bottom:14px">
<!-- wp:axiom-blocks/icon {"iconSlug":"custom:ikqim0st","iconSize":"26px","shape":"none","iconAlign":"left","url":"/"} /-->
<!-- wp:paragraph {"className":"axiom-brand","style":{"typography":{"fontSize":"21px","fontStyle":"normal","fontWeight":"600","letterSpacing":"-0.02em","lineHeight":"1"},"color":{"text":"#17131F"}}} -->
<p class="axiom-brand has-text-color" style="color:#17131F;font-size:21px;font-style:normal;font-weight:600;letter-spacing:-0.02em;line-height:1"><a href="/">Sable</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:paragraph {"style":{"typography":{"fontSize":"14.5px","lineHeight":"1.6"},"color":{"text":"#5C5768"}}} -->
<p class="has-text-color" style="color:#5C5768;font-size:14.5px;line-height:1.6">The release platform for teams who'd rather ship than sweat.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"style":{"spacing":{"blockGap":"0"}},"layout":{"type":"default"}} -->
<div class="wp-block-group">
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Product","tagName":"h4","headingColor":"#8B8797","headingFontFamily":"'DM Sans', system-ui, sans-serif","headingFontSize":"13px","headingFontWeight":"600","headingLetterSpacing":"0.1em","headingTextTransform":"uppercase","headingLineHeight":"1.2","marginBottom":"16px"} /-->
<!-- wp:axiom-blocks/icon-list {"className":"axiom-foot-links","layout":"vertical","itemsAlign":"left","items":[{"id":"p1","icon":"","text":"Features","url":"#features"},{"id":"p2","icon":"","text":"Pricing","url":"#pricing"},{"id":"p3","icon":"","text":"Changelog","url":"#"},{"id":"p4","icon":"","text":"Integrations","url":"#"}],"textColor":"#5C5768","linkColor":"#5C5768","linkHoverColor":"#17131F","fontFamily":"'DM Sans', system-ui, sans-serif","fontSize":"15px","gap":"0px","rowGap":"11px"} /-->
</div>
<!-- /wp:group -->
<!-- wp:group {"style":{"spacing":{"blockGap":"0"}},"layout":{"type":"default"}} -->
<div class="wp-block-group">
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Resources","tagName":"h4","headingColor":"#8B8797","headingFontFamily":"'DM Sans', system-ui, sans-serif","headingFontSize":"13px","headingFontWeight":"600","headingLetterSpacing":"0.1em","headingTextTransform":"uppercase","headingLineHeight":"1.2","marginBottom":"16px"} /-->
<!-- wp:axiom-blocks/icon-list {"className":"axiom-foot-links","layout":"vertical","itemsAlign":"left","items":[{"id":"r1","icon":"","text":"Docs","url":"#faq"},{"id":"r2","icon":"","text":"API","url":"#"},{"id":"r3","icon":"","text":"Status","url":"#"},{"id":"r4","icon":"","text":"Community","url":"#"}],"textColor":"#5C5768","linkColor":"#5C5768","linkHoverColor":"#17131F","fontFamily":"'DM Sans', system-ui, sans-serif","fontSize":"15px","gap":"0px","rowGap":"11px"} /-->
</div>
<!-- /wp:group -->
<!-- wp:group {"style":{"spacing":{"blockGap":"0"}},"layout":{"type":"default"}} -->
<div class="wp-block-group">
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Company","tagName":"h4","headingColor":"#8B8797","headingFontFamily":"'DM Sans', system-ui, sans-serif","headingFontSize":"13px","headingFontWeight":"600","headingLetterSpacing":"0.1em","headingTextTransform":"uppercase","headingLineHeight":"1.2","marginBottom":"16px"} /-->
<!-- wp:axiom-blocks/icon-list {"className":"axiom-foot-links","layout":"vertical","itemsAlign":"left","items":[{"id":"c1","icon":"","text":"About","url":"#"},{"id":"c2","icon":"","text":"Blog","url":"#"},{"id":"c3","icon":"","text":"Careers","url":"#"},{"id":"c4","icon":"","text":"Contact","url":"#"}],"textColor":"#5C5768","linkColor":"#5C5768","linkHoverColor":"#17131F","fontFamily":"'DM Sans', system-ui, sans-serif","fontSize":"15px","gap":"0px","rowGap":"11px"} /-->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:group -->
<!-- wp:group {"className":"axiom-fill","style":{"border":{"top":{"color":"#EBE9F2","style":"solid","width":"1px"}},"spacing":{"blockGap":"16px","padding":{"top":"26px"},"margin":{"top":"clamp(40px,6vw,64px)"}}},"layout":{"type":"flex","flexWrap":"wrap","justifyContent":"space-between"}} -->
<div class="wp-block-group axiom-fill" style="border-top-color:#EBE9F2;border-top-style:solid;border-top-width:1px;margin-top:clamp(40px,6vw,64px);padding-top:26px">
<!-- wp:paragraph {"style":{"typography":{"fontSize":"13.5px"},"color":{"text":"#8B8797"}}} -->
<p class="has-text-color" style="color:#8B8797;font-size:13.5px">© 2026 Sable, Inc. All rights reserved.</p>
<!-- /wp:paragraph -->
<!-- wp:social-links {"iconColor":"custom","customIconColor":"#5C5768","iconColorValue":"#5C5768","className":"is-style-logos-only axiom-social"} -->
<ul class="wp-block-social-links has-icon-color is-style-logos-only axiom-social"><!-- wp:social-link {"url":"#","service":"x"} /-->

<!-- wp:social-link {"url":"#","service":"github"} /-->

<!-- wp:social-link {"url":"#","service":"linkedin"} /--></ul>
<!-- /wp:social-links -->
</div>
<!-- /wp:group -->
<!-- /wp:axiom-blocks/advanced-section -->]]></content:encoded>
