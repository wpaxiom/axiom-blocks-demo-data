<!-- wp:paragraph {"style":{"typography":{"fontSize":"12px","fontStyle":"normal","fontWeight":"600","lineHeight":"1.4"},"color":{"text":"#4C1D95"}}} -->
<p class="has-text-color" style="color:#4C1D95;font-size:12px;font-style:normal;font-weight:600;line-height:1.4">New</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:paragraph {"style":{"typography":{"fontSize":"13.5px","fontStyle":"normal","fontWeight":"500","lineHeight":"1.4"},"color":{"text":"#5C5768"}}} -->
<p class="has-text-color" style="color:#5C5768;font-size:13.5px;font-style:normal;font-weight:500;line-height:1.4"><strong><span style="color:#17131F">Deploy previews</span></strong> for every pull request</p>
