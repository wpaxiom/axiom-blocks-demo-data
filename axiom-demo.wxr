		<description></description>
		<content:encoded><![CDATA[<!-- wp:axiom-blocks/advanced-section {"bgType":"gradient","bgGradType":"radial","bgGradStops":[{"color":"#F1EBFE","position":0},{"color":"#FBFBFD","position":62}],"minHeight":"auto","verticalAlign":"top","align":"full","paddingTop":"clamp(60px,9vw,104px)","paddingRight":"clamp(20px,5vw,40px)","paddingBottom":"0px","paddingLeft":"clamp(20px,5vw,40px)","layout":{"type":"constrained"}} -->
