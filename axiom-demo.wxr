<!-- wp:axiom-blocks/advanced-section {"layout":{"type":"default"},"minHeight":"auto","width":"100%","maxWidth":"640px","bgType":"color","bgColor":"transparent","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"0px","borderLeftWidth":"0px"} -->
<!-- wp:paragraph {"align":"center","style":{"typography":{"fontSize":"13px","fontStyle":"normal","fontWeight":"600","letterSpacing":"0.14em","textTransform":"uppercase"},"color":{"text":"#7C3AED"}}} -->
<p class="has-text-align-center has-text-color" style="color:#7C3AED;font-size:13px;font-style:normal;font-weight:600;letter-spacing:0.14em;text-transform:uppercase">Pricing</p>
<!-- /wp:paragraph -->
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Simple plans that scale with you","tagName":"h2","headingColor":"#17131F","headingFontFamily":"'Space Grotesk', sans-serif","headingFontSize":"clamp(28px,4vw,42px)","headingFontWeight":"600","headingLineHeight":"1.08","headingLetterSpacing":"-0.02em","headingTextAlign":"center","subEnabled":true,"subText":"Start free. Upgrade when your team does. No per-seat surprises.","subColor":"#5C5768","subFontFamily":"'DM Sans', system-ui, sans-serif","subFontSize":"clamp(17px,2vw,19px)","subLineHeight":"1.55","subTextAlign":"center","headingSubGap":"16px","marginTop":"14px"} /-->
<!-- /wp:axiom-blocks/advanced-section -->
<!-- wp:axiom-blocks/pricing-table {"columns":3,"gap":20,"accentColor":"#7C3AED","featureIconStyle":"check","cardBg":"#FFFFFF","cardBorderStyle":"solid","cardBorderTopWidth":"1px","cardBorderRightWidth":"1px","cardBorderBottomWidth":"1px","cardBorderLeftWidth":"1px","cardBorderColor":"#EBE9F2","cardRadiusTopLeft":"16px","cardRadiusTopRight":"16px","cardRadiusBottomRight":"16px","cardRadiusBottomLeft":"16px","cardShadowFeatured":"0 1px 2px #17131F0A, 0 18px 40px -20px #17131F29","cardPaddingTop":"32px","cardPaddingRight":"32px","cardPaddingBottom":"32px","cardPaddingLeft":"32px","cardGap":"0px","badgeBg":"#7C3AED","badgeColor":"#FFFFFF","badgeFontFamily":"'DM Sans', system-ui, sans-serif","badgeFontSize":"11.5px","badgeFontWeight":"600","badgeLetterSpacing":"0.08em","nameColor":"#17131F","nameFontFamily":"'Space Grotesk', sans-serif","nameFontSize":"19px","nameFontWeight":"600","descColor":"#5C5768","descFontFamily":"'DM Sans', system-ui, sans-serif","descFontSize":"14px","priceColor":"#17131F","priceFontFamily":"'Space Grotesk', sans-serif","priceFontSize":"48px","priceFontWeight":"600","priceLetterSpacing":"-0.03em","currencyColor":"#17131F","currencyFontFamily":"'Space Grotesk', sans-serif","currencyFontSize":"48px","currencyFontWeight":"600","currencyLetterSpacing":"-0.03em","periodColor":"#8B8797","periodFontFamily":"'DM Sans', system-ui, sans-serif","periodFontSize":"15px","featureColor":"#5C5768","featureFontFamily":"'DM Sans', system-ui, sans-serif","featureFontSize":"15px","featureGap":"13px","featIconColor":"#7C3AED","featIconSize":"18px","featIconGap":"10px","ctaBorderColor":"#E3E1EC","ctaBorderStyle":"solid","ctaFontFamily":"'DM Sans', system-ui, sans-serif","ctaFontSize":"16px","ctaFontWeight":"600","ctaPaddingTop":"14px","ctaPaddingBottom":"14px","ctaRadiusTopLeft":"10px","ctaRadiusTopRight":"10px","ctaRadiusBottomRight":"10px","ctaRadiusBottomLeft":"10px","headingGap":"18px","priceGap":"0px","marginTop":"56px"} -->
<!-- wp:axiom-blocks/pricing-plan {"name":"Starter","currency":"$","price":"0","period":"/ month","description":"For side projects and small teams finding their rhythm.","features":[{"id":"s1","text":"Up to 3 projects","included":true},{"id":"s2","text":"50 deploys / month","included":true},{"id":"s3","text":"Community support","included":true}],"ctaLabel":"Start free","ctaUrl":"#"} /-->
<!-- wp:axiom-blocks/pricing-plan {"name":"Team","badge":"Most popular","isHighlight":true,"currency":"$","price":"29","period":"/ user / mo","description":"For growing teams who ship every day and can't afford surprises.","features":[{"id":"t1","text":"Unlimited projects &amp; deploys","included":true},{"id":"t2","text":"Preview environments","included":true},{"id":"t3","text":"Release insights dashboard","included":true},{"id":"t4","text":"Priority support","included":true}],"ctaLabel":"Start 14-day trial","ctaUrl":"#"} /-->
<!-- wp:axiom-blocks/pricing-plan {"name":"Enterprise","price":"Custom","showCurrency":false,"showPeriod":false,"description":"For organizations with compliance and scale requirements.","features":[{"id":"e1","text":"SSO &amp; SCIM provisioning","included":true},{"id":"e2","text":"Audit logs &amp; SOC 2","included":true},{"id":"e3","text":"Dedicated success manager","included":true},{"id":"e4","text":"99.99% uptime SLA","included":true}],"ctaLabel":"Talk to sales","ctaUrl":"#"} /-->
<!-- /wp:axiom-blocks/pricing-table -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:axiom-blocks/advanced-section {"align":"full","anchor":"faq","layout":{"type":"constrained","contentSize":"1160px"},"bgType":"color","bgColor":"#FBFBFD","minHeight":"auto","verticalAlign":"top","horizontalAlign":"center","paddingTop":"clamp(72px,10vw,132px)","paddingBottom":"clamp(72px,10vw,132px)","paddingRight":"clamp(20px,5vw,40px)","paddingLeft":"clamp(20px,5vw,40px)"} -->
<!-- wp:axiom-blocks/advanced-section {"layout":{"type":"default"},"minHeight":"auto","width":"100%","maxWidth":"640px","bgType":"color","bgColor":"transparent","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"0px","borderLeftWidth":"0px"} -->
<!-- wp:paragraph {"align":"center","style":{"typography":{"fontSize":"13px","fontStyle":"normal","fontWeight":"600","letterSpacing":"0.14em","textTransform":"uppercase"},"color":{"text":"#7C3AED"}}} -->
<p class="has-text-align-center has-text-color" style="color:#7C3AED;font-size:13px;font-style:normal;font-weight:600;letter-spacing:0.14em;text-transform:uppercase">FAQ</p>
<!-- /wp:paragraph -->
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Questions, answered","tagName":"h2","headingColor":"#17131F","headingFontFamily":"'Space Grotesk', sans-serif","headingFontSize":"clamp(28px,4vw,42px)","headingFontWeight":"600","headingLineHeight":"1.08","headingLetterSpacing":"-0.02em","headingTextAlign":"center","marginTop":"14px"} /-->
<!-- /wp:axiom-blocks/advanced-section -->
<!-- wp:axiom-blocks/advanced-section {"layout":{"type":"default"},"minHeight":"auto","width":"100%","maxWidth":"800px","bgType":"color","bgColor":"transparent","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"0px","borderLeftWidth":"0px","marginTop":"52px"} -->
<!-- wp:axiom-blocks/accordion {"closeOthers":true,"firstItemOpen":true,"faqSchema":true,"headingLevel":"h3","showIcon":true,"iconSlug":"chevron-down","iconPosition":"right","rotateIcon":true,"iconColor":"#8B8797","iconColorActive":"#7C3AED","iconSize":"22px","itemGap":"0px","containerBorderStyle":"solid","containerBorderColor":"#EBE9F2","containerBorderTopWidth":"1px","borderStyle":"solid","borderColor":"#EBE9F2","borderTopWidth":"0px","borderRightWidth":"0px","borderBottomWidth":"1px","borderLeftWidth":"0px","radiusTopLeft":"0px","radiusTopRight":"0px","radiusBottomRight":"0px","radiusBottomLeft":"0px","itemBg":"transparent","itemBgHover":"transparent","bodyBg":"transparent","headerBg":"transparent","headerBgHover":"transparent","activeHeaderBg":"transparent","headerColor":"#17131F","headerColorHover":"#17131F","activeHeaderColor":"#17131F","headerFontFamily":"'Space Grotesk', sans-serif","headerFontSize":"19px","headerFontWeight":"500","headerLetterSpacing":"-0.01em","headerPaddingTop":"24px","headerPaddingRight":"4px","headerPaddingBottom":"24px","headerPaddingLeft":"4px","bodyColor":"#5C5768","bodyMaxWidth":"660px","bodyPaddingTop":"0px","bodyPaddingRight":"4px","bodyPaddingBottom":"26px","bodyPaddingLeft":"4px"} -->
<!-- wp:axiom-blocks/accordion-item {"title":"How long does it take to set up?"} -->
<!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Most teams connect their repository and ship a first preview deploy within an afternoon. There's no infrastructure to provision — Sable runs your builds and environments for you.</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/accordion-item -->
<!-- wp:axiom-blocks/accordion-item {"title":"Which git providers do you support?"} -->
<!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">GitHub, GitLab, and Bitbucket are supported out of the box, including self-hosted GitHub Enterprise. Deploys can target any major cloud or your own Kubernetes cluster.</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/accordion-item -->
<!-- wp:axiom-blocks/accordion-item {"title":"Can I roll back a bad release?"} -->
<!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Yes — every release is atomic and immutable. Rolling back is a single click and takes effect in seconds, with zero downtime and no partial states.</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/accordion-item -->
<!-- wp:axiom-blocks/accordion-item {"title":"Is my data secure?"} -->
<!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Secrets are encrypted at rest and in transit, scoped per environment, and never exposed in logs. Enterprise plans add SSO, audit logging, and SOC 2 Type II compliance.</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/accordion-item -->
<!-- wp:axiom-blocks/accordion-item {"title":"What happens when my trial ends?"} -->
<!-- wp:paragraph {"style":{"typography":{"fontSize":"16px","lineHeight":"1.62"}}} -->
<p style="font-size:16px;line-height:1.62">Nothing breaks. Your projects stay live and you drop to the free Starter plan automatically unless you choose to upgrade. No credit card is required to start.</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/accordion-item -->
<!-- /wp:axiom-blocks/accordion -->
<!-- /wp:axiom-blocks/advanced-section -->
<!-- /wp:axiom-blocks/advanced-section -->

<!-- wp:axiom-blocks/advanced-section {"align":"full","layout":{"type":"constrained","contentSize":"720px"},"bgType":"gradient","bgGradType":"radial","bgGradStops":[{"color":"#221A34","position":0},{"color":"#171225","position":70}],"minHeight":"auto","verticalAlign":"top","horizontalAlign":"center","paddingTop":"clamp(72px,10vw,132px)","paddingBottom":"clamp(72px,10vw,132px)","paddingRight":"clamp(20px,5vw,40px)","paddingLeft":"clamp(20px,5vw,40px)"} -->
<!-- wp:axiom-blocks/advanced-heading {"headingText":"Your next release could be your calmest","tagName":"h2","headingColor":"#FFFFFF","headingFontFamily":"'Space Grotesk', sans-serif","headingFontSize":"clamp(30px,4.4vw,48px)","headingFontWeight":"600","headingLineHeight":"1.08","headingLetterSpacing":"-0.025em","headingTextAlign":"center","subEnabled":true,"subText":"Join 1,200+ teams shipping with confidence. Free to start, no card required.","subColor":"#C7C0DA","subFontFamily":"'DM Sans', system-ui, sans-serif","subFontSize":"clamp(18px,2.2vw,21px)","subLineHeight":"1.55","subTextAlign":"center","headingSubGap":"18px","marginBottom":"30px"} /-->
<!-- wp:axiom-blocks/button-group {"justify":"center","gap":12} -->
<!-- wp:axiom-blocks/advanced-button {"text":"Start free","url":"#","stylePreset":"fill","sizePreset":"lg","bgColor":"#FFFFFF","textColor":"#171225","hoverBgColor":"#F1EEFB","hoverTextColor":"#171225","borderRadius":"10px","icon":"arrow-right","iconPosition":"right","iconSize":"17px","iconGap":"8px","fontFamily":"'DM Sans', system-ui, sans-serif","fontSize":"16px","fontWeight":"600","lineHeight":"1","buttonPaddingTop":"14px","buttonPaddingRight":"22px","buttonPaddingBottom":"14px","buttonPaddingLeft":"22px"} /-->
<!-- wp:axiom-blocks/advanced-button {"text":"Book a demo","url":"#","stylePreset":"outline","sizePreset":"lg","bgColor":"transparent","textColor":"#FFFFFF","borderStyle":"solid","borderWidth":"1px","borderColor":"#FFFFFF47","borderRadius":"10px","hoverBgColor":"transparent","hoverTextColor":"#FFFFFF","hoverBorderColor":"#FFFFFF","fontFamily":"'DM Sans', system-ui, sans-serif","fontSize":"16px","fontWeight":"600","lineHeight":"1","buttonPaddingTop":"14px","buttonPaddingRight":"22px","buttonPaddingBottom":"14px","buttonPaddingLeft":"22px"} /-->
<!-- /wp:axiom-blocks/button-group -->
<!-- wp:paragraph {"align":"center","style":{"typography":{"fontSize":"13.5px"},"color":{"text":"#8B84A0"},"spacing":{"margin":{"top":"18px"}}}} -->
<p class="has-text-align-center has-text-color" style="color:#8B84A0;font-size:13.5px;margin-top:18px">14-day Team trial · cancel anytime</p>
<!-- /wp:paragraph -->
<!-- /wp:axiom-blocks/advanced-section -->]]></content:encoded>
