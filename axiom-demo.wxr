		<title><![CDATA[Custom Styles]]></title>
		<link>https://wpaxiom.com/wp-global-styles-twentytwentyfive/</link>
		<pubDate>Tue, 14 Jul 2026 14:40:31 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">https://wpaxiom.com/wp-global-styles-twentytwentyfive/</guid>
		<description></description>
		<content:encoded><![CDATA[{"styles":{"color":{"background":"var(--wp--preset--color--base)","text":"var(--wp--preset--color--muted)"},"typography":{"fontFamily":"var(--wp--preset--font-family--dm-sans)","fontSize":"18px","lineHeight":"1.6"},"elements":{"heading":{"typography":{"fontFamily":"var(--wp--preset--font-family--space-grotesk)","fontWeight":"600","letterSpacing":"-0.02em"},"color":{"text":"var(--wp--preset--color--contrast)"}},"link":{"color":{"text":"var(--wp--preset--color--accent)"}},"button":{"color":{"background":"var(--wp--preset--color--accent)","text":"#FFFFFF"},"border":{"radius":"10px"}}},"css":"@font-face{font-family:'DM Sans';font-style:normal;font-weight:100 900;font-display:swap;src:url(https://fonts.gstatic.com/s/dmsans/v17/rP2Yp2ywxg089UriI5-g4vlH9VoD8Cmcqbu0-K4.woff2) format('woff2')}@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:300 700;font-display:swap;src:url(https://fonts.gstatic.com/s/spacegrotesk/v22/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2) format('woff2')}.axiom-fill{width:100%}.axiom-head{overflow:visible;-webkit-backdrop-filter:saturate(1.4) blur(14px);backdrop-filter:saturate(1.4) blur(14px)}.axiom-brand a{color:inherit;text-decoration:none}.axiom-foot-links .ab-icon-list__icon:empty{display:none}.axiom-foot-links .ab-icon-list__link{text-decoration:none}.axiom-social .wp-social-link{border:1px solid #EBE9F2;border-radius:10px}.axiom-social .wp-social-link:hover{border-color:#7C3AED}.wp-block-group.axiom-foot-grid{grid-template-columns:1fr}@media(min-width:901px){.wp-block-group.axiom-foot-grid{grid-template-columns:1.6fr 1fr 1fr 1fr}}.wp-block-post-title{display:none!important}.axiom-blocks-section.is-layout-flow\u003E*,.axiom-blocks-section.is-layout-constrained\u003E*{margin-block-start:0}.axiom-shot{margin:0!important}.axiom-shot img{display:block;width:100%;height:auto}html{scroll-behavior:smooth}::selection{background:#F1EBFE;color:#4C1D95}.ab-accordion{width:100%}.ab-accordion__body-inner.ab-accordion_